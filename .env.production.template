# Glass Budget - Production Environment Configuration
# Copy this file to .env.production and fill in the values

# Database
# SQLite database will be stored in a persistent location
# Change the path below to where you want to store your database on Windows
# Example: C:/glass-budget-data/database.db or file:./data/production.db
DATABASE_URL=file:./data/production.db

# NextAuth Configuration
# Generate a secure random secret using this command in PowerShell:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=REPLACE_WITH_GENERATED_SECRET

# NextAuth URL - This should be your Windows PC's local IP address
# To find your IP on Windows: Open Command Prompt and run "ipconfig"
# Look for "IPv4 Address" under your network adapter (usually starts with 192.168.x.x)
# Example: http://192.168.1.100:3000
NEXTAUTH_URL=http://YOUR_WINDOWS_IP:3000

# Node Environment
NODE_ENV=production
